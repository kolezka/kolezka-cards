# 32+ random bytes (hex). Used for HMAC of daily salt and session IDs.
# Generate: openssl rand -hex 32
APP_SECRET=

# Public base URL of the deployed app (used for OAuth callback origin, CSRF Origin check)
BASE_URL=http://localhost:3001

# SQLite file path (relative to repo root in dev, absolute /data/app.db in prod)
DATABASE_PATH=./data/app.db

# Environment
NODE_ENV=development

# Reserved for Phase 3 (GitHub OAuth via Arctic):
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Reserved for Phase 7 (Sentry):
# SENTRY_DSN=
