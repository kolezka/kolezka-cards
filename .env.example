# Required ---------------------------------------------------------

# 32+ random bytes (hex). Used for HMAC of daily salt and session ids.
# Generate: openssl rand -hex 32
APP_SECRET=

# Public base URL of the deployed app. Used for OAuth callback origin
# and the CSRF Origin check on /api/* mutations.
BASE_URL=https://cards.example.com

# SQLite file path. Repo-relative for local dev; in Coolify, override
# to /data/app.db and mount a volume at /data.
DATABASE_PATH=./data/app.db

# development | test | production
NODE_ENV=production

# Optional ---------------------------------------------------------

# GitHub OAuth app. /auth/github returns 503 if either is unset.
# Register at https://github.com/settings/applications/new with the
# callback URL set to: $BASE_URL/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Sentry DSN — optional. When set, the api process initializes
# @sentry/node lazily and forwards unhandled errors. Missing module is
# tolerated; init failures log WARN and do not abort boot.
# SENTRY_DSN=

# Absolute path to the SvelteKit static build that Hono should serve.
# Set in the production Dockerfile; leave empty in dev (Vite serves
# the frontend on :5173 and proxies API calls to :3001).
# WEB_BUILD_DIR=/app/apps/web/build

# Port the Hono server binds to. Default 3001 in dev, 3000 in the
# production Dockerfile.
# PORT=3000
