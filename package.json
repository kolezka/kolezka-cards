{
  "name": "kolezka-cards",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "db:generate": "bun --env-file=.env --filter @kc/db db:generate",
    "db:migrate": "bun --env-file=.env --filter @kc/db db:migrate",
    "db:check": "bun --env-file=.env --filter @kc/db db:check",
    "db:studio": "bun --env-file=.env --filter @kc/db db:studio",
    "db:seed": "bun --env-file=.env --filter @kc/db db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "lefthook": "^1.10.10",
    "typescript": "^5.6.3"
  }
}
